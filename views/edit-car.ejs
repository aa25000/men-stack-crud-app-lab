<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <h1>Edit Car</h1>

    
 
    <form action="/cars/<%=car._id %>?_method=PUT" method="post">



        <label for="name">Name:</label>
        <input value="<%=car.name %>" name="name" id="name" type="text">



        <label for="isElectric">Is Electric?</label>
        <input <% if(car.isElectric){ %> checked <% } %> name="isElectric" id="isElectric" type="checkbox">

        <button>Update Car</button>

    </form>
</body>
</html>